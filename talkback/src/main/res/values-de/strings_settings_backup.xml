<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the settings screen and its entry in the main list, for saving and restoring all settings. [CHAR LIMIT=40] -->
    <string name="settings_backup_title">sichern und wiederherstellen</string>
    <!-- Backup and restore: saves all settings to a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_export">Einstellungen exportieren</string>
    <!-- Summary of the export action. [CHAR LIMIT=NONE] -->
    <string name="settings_backup_export_summary">Speichert alle Einstellungen in einer Datei.</string>
    <!-- Backup and restore: loads all settings from a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_import">Einstellungen importieren</string>
    <!-- Summary of the import action. [CHAR LIMIT=NONE] -->
    <string name="settings_backup_import_summary">Ersetzt deine Einstellungen mit denen einer exportierten Datei. Einstellungen, die das Telefon betreffen, wie etwa verbunde Braillezeilen und dein Gemini API Schlüssel, bleiben unverändert.</string>
    <!-- Toast after the settings were saved to a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_export_done">Einstellungen exportiert</string>
    <!-- Toast when the settings could not be saved to a file. [CHAR LIMIT=60] -->
    <string name="settings_backup_export_failed">Konnte einstellungen nicht exportieren</string>
    <!-- Toast after the settings were restored from a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_import_done">Einstellungen importiert</string>
    <!-- Dialog message after the settings were restored, when some of them only take effect once Backtalk is turned off and on again. [CHAR LIMIT=NONE] -->
    <string name="settings_backup_import_restart">einige importierte Einstellungen erfordern das Aus- und wieder Einschalten von BackTalk, damit diese wirksam werden.</string>
    <!-- Toast when a file could not be read as a settings backup. [CHAR LIMIT=60] -->
    <string name="settings_backup_import_failed">Konnte diese Datei nicht lesen</string>
</resources>
